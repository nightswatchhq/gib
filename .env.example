# Gateway-in-a-Box — operator config. Copy to `.env` and fill the TODOs.
#
# Format rules (this file is read by render.sh AND docker --env-file):
#   • KEY=VALUE, one per line. NO inline comments after a value.
#   • No quotes needed; values are taken literally (spaces/commas are fine).
#
# Contract addresses are NOT set here — run `./scripts/fetch-addresses.sh` to pull
# verified Horizon addresses from graphprotocol/contracts into config/addresses.env.
# Private keys are NOT set here — `render.sh` injects them from your secrets dir.

# --- network -----------------------------------------------------------------
# 42161 = Arbitrum One (the only production Horizon chain today).
CHAIN_ID=42161
# Arbitrum One RPC. Public endpoint works for low volume; use your own for production.
ARB_RPC=https://arb1.arbitrum.io/rpc

# --- TAP sender --------------------------------------------------------------
# The payer/sender wallet ADDRESS (public). Its private key lives in the secrets
# dir as sender.txt — never put the key here. Indexers whitelist THIS address.
# TODO: your funded sender wallet.
SENDER_ADDRESS=

# --- network subgraph --------------------------------------------------------
# The Graph Network (Arbitrum One) subgraph — indexer/allocation/escrow discovery.
# `trusted_indexers` speaks the indexer-service envelope ({graphQLResponse,
# attestation}), NOT raw GraphQL — you cannot point it at a decentralised-gateway
# URL directly. And post-Horizon EVERY real indexer (incl. the upgrade indexer)
# gates the network subgraph behind a TAP receipt (verified: 402 "No Tap receipt
# was found"). So gib currently has NO built-in keyless topology source — this is
# a known product gap (see docs/03-operations.md). You must supply an
# envelope-returning endpoint yourself, e.g. a cooperating indexer's free-serve
# endpoint plus the bearer token they issue you:
#       NETWORK_SUBGRAPH_URL=https://their-indexer.example/subgraphs/id/QmU5tKrP7…dQBv
#       NETWORK_SUBGRAPH_AUTH=<free-query token>
# Arbitrum network-subgraph deployment id: QmU5tKrP7YNpm69iUdC3YuQWfJmdye1AHJLLc5pRC4dQBv
NETWORK_SUBGRAPH_URL=
NETWORK_SUBGRAPH_AUTH=

# --- consumer side -----------------------------------------------------------
# Static API key(s) clients send as `Authorization: Bearer <key>`. With gib you ARE
# the key service — no Edge & Node Studio dependency. Comma-separate for multiple.
# MUST be exactly 32 hex chars (16 bytes) — the gateway rejects any other length
# with "malformed API key" (auth.rs parse_api_key). Generate: `openssl rand -hex 16`.
GATEWAY_API_KEYS=

# --- economics ---------------------------------------------------------------
# Fixed GRT/USD rate for query-fee budgeting (avoids a price-feed dependency).
GRT_USD=0.09
# Target indexer fee paid per query, in USD.
QUERY_FEES_TARGET=20e-6
# Escrow GRT ceiling the escrow-manager may approve/deposit across all indexers.
GRT_ALLOWANCE=1000

# --- payments ----------------------------------------------------------------
# Start false to validate query routing with no on-chain funds (no 402s). Flip to
# true once escrow is funded — see docs/02-onchain-escrow.md.
PAYMENT_REQUIRED=false
# Escrow-manager dry-run: true = log intended authorize/deposit txs but DON'T send.
# Keep true on first boot; set false to actually fund escrow.
ESCROW_DRY_RUN=true

# --- indexer selection (gib patch) -------------------------------------------
# Optional per-dimension importance exponents for the query-time selector. The score
# is a product of four curves; each exponent dials that dimension's influence
# (score_i ^ weight). Blank = 1.0 = stock gateway behaviour. See docs/03-operations.md.
# Query success rate:
SELECTION_WEIGHT_SUCCESS_RATE=
# Expected response latency:
SELECTION_WEIGHT_LATENCY=
# Data freshness (seconds behind chain head):
SELECTION_WEIGHT_SECONDS_BEHIND=
# Economic security (slashable GRT):
SELECTION_WEIGHT_SLASHABLE_GRT=

# --- version floors ----------------------------------------------------------
MIN_GRAPH_NODE_VERSION=0.0.0
MIN_INDEXER_VERSION=0.0.0
NETWORK_SUBGRAPH_MAX_LAG_SECONDS=300

# --- aggregator: accepted receipt signers -----------------------------------
# The tap-aggregator ALWAYS accepts receipts signed by its own wallet (the key
# in secrets/signer.txt, which is also the gateway's receipt signer) — so the
# default self-deal loop works with nothing set here.
#
# ⚠️ LATENT TRAP: the moment you rotate the signer, or run a SECOND gateway with
# a different signer, or accept receipts from another sender, the aggregator will
# SILENTLY REJECT those receipts ("Recovered sender address invalid") unless that
# signer's ADDRESS is listed here. Comma-separated 0x addresses (NOT private
# keys). Leave commented for the single-signer default.
# GRAPH_TALLY_PUBLIC_KEYS=0xSignerAddressOne,0xSignerAddressTwo

# --- images ------------------------------------------------------------------
# Pinned to an immutable commit tag for reproducible pulls (GHCR also tags every
# commit as sha-<short>). `latest` floats — don't rely on it for real deploys.
# To take a newer gateway build, bump this to its sha-<short> tag.
# sha-02ea695 == digest sha256:97fc0ad9bfc34e3a18fd22f57f0fa55360a8ae943b2ab9023851e9bf84eacf85
GATEWAY_IMAGE_TAG=sha-02ea695
AGGREGATOR_IMAGE_TAG=v0.7.1
ESCROW_IMAGE_TAG=v2.0.0

# --- ports -------------------------------------------------------------------
# Public query endpoint:
GATEWAY_PORT=7700
# PUBLIC — indexers must reach this:
AGGREGATOR_PORT=7610
# localhost-only:
GATEWAY_METRICS_PORT=7301
ESCROW_METRICS_PORT=9090
PROMETHEUS_PORT=9091
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin

# --- secrets -----------------------------------------------------------------
# Directory holding sender.txt + signer.txt (each with a `Private key: 0x...` line),
# mode 600, OUTSIDE version control. render.sh reads keys from here.
SECRETS_DIR=./secrets

# --- logging -----------------------------------------------------------------
RUST_LOG=info
